+    uint8_t downlink_mode; // 0=Fixed, 1=LongLeading, 2=Leading0, 3=1of4
+
+    // Cracker
+    uint8_t crack_method; // 0=White Cloner, 1=Dictionary
+    uint32_t crack_tested;

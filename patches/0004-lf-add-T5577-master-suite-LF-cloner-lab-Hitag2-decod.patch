+        canvas_draw_str(canvas, 2, 23, buf);
+
+        snprintf(
+            buf,
+            sizeof(buf),
+            "Harvested: %08lX %s",
+            (unsigned long)model->snoop_pwd,
+            model->snoop_found ? "[CAPTURED!]" : "[--]");

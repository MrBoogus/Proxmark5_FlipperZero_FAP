+    if(flags & MAGIC_FLAG_GEN_1B) return "Gen1b";
+    if(flags & MAGIC_FLAG_NTAG21X) return "MagicNTAG";
+    if(flags & (MAGIC_FLAG_SUPER_GEN1 | MAGIC_FLAG_SUPER_GEN2)) return "SuperCard";
+    if(flags & MAGIC_FLAG_GEN_UNFUSED) return "Unfused";
+    return "Std";
